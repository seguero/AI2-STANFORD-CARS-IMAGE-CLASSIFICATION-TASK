      "source": [
        "full_data.columns = ['filename', 'x1', 'y1', 'x2', 'y2', 'label']\n",
        "\n",
        "def parse_car_name(car_name):\n",
        "    parts = car_name.split()\n",
        "    year = parts[-1]  # Last part is the year\n",
        "    type = parts[-2]  # Second to last part is the type\n",
        "    brand = parts[0]  # First part is the brand\n",
        "    model = ' '.join(parts[1:-2])  # Everything else is the model\n",
        "    return brand, model, type, year"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 11,
      "id": "d8c493e5-b7c5-46f7-b1c6-24ec03154461",
      "metadata": {
        "colab": {
