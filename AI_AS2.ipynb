        "**Loading and processing images**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 23,
      "id": "RbYZf_UwRyCd",
      "metadata": {
        "id": "RbYZf_UwRyCd"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import cv2\n",
        "\n",
        "def load_and_process_images(data, img_dir):\n",
        "    images = []\n",
        "    labels = []\n",
        "    for _, row in data.iterrows():\n",
        "        img_path = f\"{img_dir}/{row['filename']}\"\n",
        "        img = cv2.imread(img_path)\n",
        "        if img is not None:\n",
        "            x1, y1, x2, y2 = int(row['x1']), int(row['y1']), int(row['x2']), int(row['y2'])\n",
        "            cropped_img = img[y1:y2, x1:x2]\n",
        "            resized_img = cv2.resize(cropped_img, (224, 224))\n",
        "            normalized_img = resized_img.astype('float32') / 255.0  # Ensure the dtype is float32\n",
        "            images.append(normalized_img)\n",
        "            labels.append(row['label'])\n",
        "    return np.array(images), np.array(labels)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 24,
      "id": "vXtikXu2QbrA",
      "metadata": {
        "id": "vXtikXu2QbrA"
      },
      "outputs": [],
      "source": [
        "train_images, train_labels = load_and_process_images(train_data, 'data/train_split')\n",
        "val_images, val_labels = load_and_process_images(val_data, 'data/val_split')\n",
        "test_images, test_labels = load_and_process_images(test_data, 'data/test_split')"
      ]
    },
